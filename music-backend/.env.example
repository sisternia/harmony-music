# Accounts service: SQLite and console email are used when DB_NAME and SMTP settings are absent.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Set DB_NAME to use PostgreSQL instead of the local db.sqlite3.
# DB_NAME=music
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Configure SMTP to deliver verification emails instead of printing them in the terminal.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@example.com
VERIFY_CODE_EXPIRE_MINUTES=10
